    {
      "parameters": {
        "jsCode": "\nconst CFG = {\n  matchIdCol: 'match_id',\n  feelingsCol: 'volunteer_feelings',\n  submittedAtCol: 'Submitted at'\n};\n\n// Se houver mais de uma resposta para o mesmo match_id, vale a mais recente\nconst latest = new Map();\nfor (const item of $input.all()) {\n  const r = item.json;\n  const match_id = String(r[CFG.matchIdCol] ?? '').trim();\n  if (!match_id) continue;\n  const ts = new Date(r[CFG.submittedAtCol] ?? 0).getTime() || 0;\n  const prev = latest.get(match_id);\n  if (!prev || ts >= prev.ts) {\n    latest.set(match_id, { ts, volunteer_feelings: String(r[CFG.feelingsCol] ?? '').trim() });\n  }\n}\n\nreturn [...latest].map(([match_id, v]) => ({\n  json: { match_id, volunteer_feelings: v.volunteer_feelings }\n}));"
      },
