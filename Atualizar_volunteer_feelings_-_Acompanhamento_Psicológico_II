        "jsCode": "const atualizados = $('Atualizar volunteer_feelings').all().filter(i => i.json.match_id).length;\nconst restantes = $input.all().filter(i => i.json.match_id).map(i => i.json.match_id);\nconst semCorrespondencia = $('Cruzar por match_id').all().map(i => i.json).filter(j => j.status === 'unmatched');\n\n// Respostas do CSV sem registro com placeholder no BD\nconst idsBD = new Set($('Buscar registros com placeholder').all().map(i => String(i.json.match_id)));\nconst csvSemRegistro = $('Normalizar CSV').all()\n  .map(i => i.json)\n  .filter(r => r.volunteer_feelings && !idsBD.has(r.match_id))\n  .map(r => r.match_id);\n\nreturn [{ json: {\n  atualizados,\n  placeholders_restantes: restantes.length,\n  ids_restantes: restantes,\n  bd_sem_resposta_no_csv: semCorrespondencia,\n  csv_sem_registro_com_placeholder: csvSemRegistro,\n  status: restantes.length === 0 && semCorrespondencia.length === 0 ? 'OK' : 'REVISAR'\n} }];"
