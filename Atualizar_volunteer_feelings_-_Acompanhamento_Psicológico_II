      "notes": "Filtra registros onde volunteer_feelings ficou com o texto literal {{ $json.volunteer_experience.volunteer_feelings }} (expressão não resolvida)."
    },
    {
      "parameters": {
        "jsCode": "// Cruza os registros do BD (input) com as linhas do CSV pelo match_id\nconst csv = $('Normalizar CSV').all().map(i => i.json);\nconst byId = new Map(csv.map(r => [r.match_id, r]));\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  if (!row.match_id) continue; // BD sem resultados\n  const hit = byId.get(String(row.match_id));\n  if (hit && hit.volunteer_feelings) {\n    out.push({ json: { status: 'matched', match_id: row.match_id, volunteer_feelings: hit.volunteer_feelings } });\n  } else {\n    out.push({ json: { status: 'unmatched', match_id: row.match_id, motivo: hit ? 'Resposta vazia no CSV' : 'match_id não encontrado no CSV' } });\n  }\n}\n\nreturn out;"
      },
