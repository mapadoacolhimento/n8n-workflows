        "query": "SELECT \n    m.msr_id,\n    pii.email AS msr_email,\n    socio.msr_socioeconomic_id AS socio_id,\n    violence.msr_violence_history_id AS violence_id\nFROM msr.msrs m\nINNER JOIN pii_sec.msr_pii pii ON m.msr_id = pii.msr_id\nLEFT JOIN msr.msr_socioeconomic_data socio ON m.msr_id = socio.msr_id\nLEFT JOIN msr.msr_violence_history violence ON m.msr_id = violence.msr_id\nWHERE m.status != 'unregistered'\n  AND (socio.msr_socioeconomic_id IS NULL OR violence.msr_violence_history_id IS NULL)\nORDER BY m.created_at ASC;",
