      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const pgResult = $('Loop Over Items1').item.json;\nconst mongo = $('Buscar MSR no MongoDB1').item.json;\nconst msr_id = pgResult.msr_id;\nconst needsSocioInsert = !pgResult.socio_id;\nconst needsViolenceInsert = !pgResult.violence_id;\n\nconst toBool = (val) => {\n  if (val === 'yes' || val === true) return true;\n  if (val === 'no' || val === false) return false;\n  return null;\n};\n\nconst toArray = (val) => Array.isArray(val) ? val : (val ? [val] : []);\n\nconst mapMonthlyIncomeRange = (val) => {\n  const map = new Map([\n    [0,   'no_income'],\n    [0.5, 'half_minimum_wage'],\n    [1,   'up_to_one_minimum_wage'],\n    [2,   'up_to_two_minimum_wages'],\n    [3,   'up_to_three_minimum_wages'],\n    [4,   'up_to_four_minimum_wages'],\n    [5,   'five_minimum_wages_or_more'],\n  ]);\n  return map.get(parseFloat(val)) ?? null;\n};\n\nconst mapFamilyProvider = (val) => {\n  const map = {\n    'yes': 'yes',\n    'no': 'no',\n    'partially': 'shared_responsibility',\n    'shared_responsibility': 'shared_responsibility',\n  };\n  return map[val] ?? null;\n};\n\nconst mapHasMonthlyIncome = (val) => {\n  const map = {\n    'yes': 'yes',\n    'no': 'no',\n    'noAccess': 'no_access',\n    'no_access': 'no_access',\n  };\n  return map[val] ?? null;\n};\n\nconst mapEmploymentStatus = (val) => {\n  const map = {\n    'employedClt': 'employed_clt',\n    'employedPj': 'employed_pj',\n    'employed_clt': 'employed_clt',\n    'employed_pj': 'employed_pj',\n    'student': 'student',\n    'student_with_income': 'student_with_income',\n    'retired': 'retired',\n    'unemployed': 'unemployed',\n  };\n  return map[val] ?? null;\n};\n\nconst mapViolenceType = (val) => {\n  const map = {\n    'physicalViolence': 'physical_violence',\n    'psychologicalViolence': 'psychological_violence',\n    'digitalViolence': 'digital_violence',\n    'patrimonialViolence': 'patrimonial_violence',\n    'sexualViolence': 'sexual_violence',\n    'obstetricViolence': 'obstetric_violence',\n    'politicalViolence': 'political_violence',\n    'moralViolence': 'moral_violence',\n    'noViolence': 'no_violence',\n    'threat': 'threat',\n    'physical_violence': 'physical_violence',\n    'psychological_violence': 'psychological_violence',\n    'digital_violence': 'digital_violence',\n    'patrimonial_violence': 'patrimonial_violence',\n    'sexual_violence': 'sexual_violence',\n    'obstetric_violence': 'obstetric_violence',\n    'political_violence': 'political_violence',\n    'moral_violence': 'moral_violence',\n    'no_violence': 'no_violence',\n  };\n  return map[val] ?? val;\n};\n\nconst socio_payload = needsSocioInsert ? {\n  msr_id,\n  has_monthly_income: mapHasMonthlyIncome(mongo.monthlyIncome),\n  monthly_income_range: mapMonthlyIncomeRange(mongo.monthlyIncomeRange),\n  employment_status: mapEmploymentStatus(mongo.employmentStatus),\n  has_financial_dependents: toBool(mongo.dependants),\n  family_provider: mapFamilyProvider(mongo.familyProvider) || null,\n  property_ownership: toBool(mongo.propertyOwnership)\n} : null;\n\nconst violence_payload = needsViolenceInsert ? {\n  msr_id,\n  violence_occurred_in_brazil: true,\n  violence_type: toArray(mongo.violenceType).map(mapViolenceType),\n  violence_location: toArray(mongo.violenceLocation),\n  violence_perpetrator: toArray(mongo.violencePerpetrator),\n  legal_actions_taken: toArray(mongo.legalActionsTaken),\n  protective_factors: toArray(mongo.protectiveFactors),\n  risk_factors: toArray(mongo.riskFactors),\n  legal_action_difficulty: toArray(mongo.legalActionDifficulty),\n  violence_time: mongo.violenceTime || null,\n  perpetrator_gender: mongo.perpetratorGender || null,\n  lives_with_perpetrator: mongo.livesWithPerpetrator || null\n} : null;\n\nreturn {\n  json: {\n    msr_id,\n    needs_socio_insert: needsSocioInsert,\n    needs_violence_insert: needsViolenceInsert,\n    socio_payload: socio_payload ?? {},\n    violence_payload: violence_payload ?? {}\n  }\n};"
