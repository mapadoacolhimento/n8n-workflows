    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    sr.zendesk_ticket_id AS ticket_id,\n    'pedido' AS origem,\n    sr.status::text AS status_banco,\n    sr.created_at\nFROM match.support_requests sr\nWHERE sr.zendesk_ticket_id = ANY(string_to_array($1, ',')::bigint[])\n\nUNION ALL\n\n(\n    SELECT\n        m.msr_zendesk_ticket_id AS ticket_id,\n        'match_acolhida' AS origem,\n        m.status::text AS status_banco,\n        m.created_at\n    FROM match.matches m\n    WHERE m.msr_zendesk_ticket_id = ANY(string_to_array($1, ',')::bigint[])\n    ORDER BY m.created_at DESC\n    LIMIT 1\n)\n\nUNION ALL\n\nSELECT\n    m.volunteer_zendesk_ticket_id AS ticket_id,\n    'match_voluntaria' AS origem,\n    m.status::text AS status_banco,\n    m.created_at\nFROM match.matches m\nWHERE m.volunteer_zendesk_ticket_id = ANY(string_to_array($1, ',')::bigint[]);\n",
        "options": {
          "queryReplacement": "={{ [$json.ids.join(',')] }}"
        }
      },
