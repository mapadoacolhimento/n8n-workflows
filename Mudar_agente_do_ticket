    {
      "parameters": {
        "jsCode": "const FIELD_ID_STATUS = 360014379412;          // ID do campo \"Status do Acolhimento\"\nconst SUBDOMINIO = 'mapadoacolhimento';\n\n// valor do campo no Zendesk -> status do pedido no banco\nconst MAPA_PEDIDO = {\n  'solicitação_recebida': 'open',\n  'encaminhamento__realizado_para_serviço_público': 'public_service',\n  'encaminhamento__realizado': 'matched',\n  'atendimento__iniciado': 'matched',\n  'atendimento__concluído': 'matched',\n  \"encaminhamento__expirado\": \"matched\",\n  'atendimento__interrompido': 'matched',\n  'encaminhamento_interrompido':  'matched',\n  'encaminhamento__assistente_social': 'social_worker',\n  'encaminhamento__servico_publico_com_assistente_social': 'public_service_with_social_worker',\n  'aguardando_match__sem_prioridade': 'waiting_for_match',\n  'aguardando_match__com_prioridade': 'waiting_for_match_with_priority',\n  'desistencia': 'waived',\n  'encaminhamento__aguardando_confirmação': 'waiting_for_confirmation',\n  'solicitação_encerrada': 'closed',\n  'solicitação_repetida': 'duplicated',\n};\n\n// valor do campo no Zendesk -> status do match no banco\nconst MAPA_MATCH = {\n  'encaminhamento__realizado': 'waiting_contact',\n  'encaminhamento_interrompido': 'interrupted_before_support',\n  'atendimento__iniciado': 'in_contact',\n  'atendimento__concluído': 'completed',\n  'atendimento__interrompido': 'interrupted_after_support',\n  'encaminhamento__expirado': 'expired',\n};\n\nconst tickets = $('Loop Over Items').all()\n  .flatMap(i => i.json.tickets || [])\n  .filter(t => t.status !== 'closed');\n\nconst porTicket = new Map();\nfor (const { json: r } of $('Consulta banco').all()) {\n  if (!r.ticket_id) continue;\n  const k = String(r.ticket_id);\n  if (!porTicket.has(k)) porTicket.set(k, []);\n  porTicket.get(k).push(r);\n}\n\nreturn tickets.map(t => {\n  const campo = (t.custom_fields || []).find(c => c.id === FIELD_ID_STATUS);\n  const valorZendesk = campo ? campo.value : null;\n  const rows = porTicket.get(String(t.id)) || [];\n\n  const base = {\n    ticket_id: t.id,\n    link: `https://${SUBDOMINIO}.zendesk.com/agent/tickets/${t.id}`,\n    status_zendesk: valorZendesk || 'sem valor',\n  };\n  const reatribuir = (categoria, extra = {}) =>\n    ({ json: { ...base, ...extra, acao: 'reatribuir', categoria } });\n  const revisar = (categoria, extra = {}) =>\n    ({ json: { ...base, ...extra, acao: 'revisar', categoria } });\n\n  // sem relação com pedido nem match\n  if (!rows.length) return reatribuir('sem_relacao');\n\n  const matchesAcolhida = rows\n    .filter(r => r.origem === 'match_acolhida')\n    .sort((a, b) => new Date(b.criado_em) - new Date(a.criado_em));\n  const pedidos = rows.filter(r => r.origem === 'pedido');\n  const deVoluntaria = rows.some(r => r.origem === 'match_voluntaria');\n\n  // ticket da voluntária: não usa o campo, reatribui direto\n  if (!matchesAcolhida.length && !pedidos.length && deVoluntaria) {\n    return reatribuir('ticket_voluntaria');\n  }\n\n  if (!matchesAcolhida.length && pedidos.length > 1) {\n    return revisar('multiplos_pedidos', {\n      status_banco: pedidos.map(p => p.status_banco).join(' | '),\n    });\n  }\n\n  // se há match, vale o mais recente; senão, o status do pedido\n  const ref = matchesAcolhida[0] || pedidos[0];\n  const mapa = matchesAcolhida.length ? MAPA_MATCH : MAPA_PEDIDO;\n  const extra = { origem: ref.origem, status_banco: ref.status_banco };\n\n  if (!valorZendesk) return revisar('campo_zendesk_vazio', extra);\n\n  const esperado = mapa[valorZendesk];\n  if (esperado === undefined) return revisar('valor_zendesk_sem_mapeamento', extra);\n  if (esperado === ref.status_banco) return reatribuir('status_ok', extra);\n  return revisar('status_divergente', extra);\n});"
      },
