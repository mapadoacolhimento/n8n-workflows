        "jsCode": "const EXPECTED_COLUMNS = [\n  \"Doador ID\", \"Nome\", \"Email\", \"Documento\", \"Doações Realizadas\", \"Total Doado\",\n  \"Tipo\", \"Tag\", \"Data Criação Doador\", \"Gênero\", \"Data de Nascimento\", \"Empresa\",\n  \"Cargo\", \"Estado Civil\", \"Rua\", \"Número\", \"Bairro\", \"Cidade\", \"Estado\", \"País\",\n  \"CEP\", \"Telefone\"\n];\n\nconst items = $input.all();\n\nif (items.length === 0) {\n  console.log(\"[Doare Sync] CSV recebido está vazio — nenhuma linha de dados encontrada.\");\n} else {\n  const receivedColumns = Object.keys(items[0].json);\n\n  const missing = EXPECTED_COLUMNS.filter(col => !receivedColumns.includes(col));\n  const extra = receivedColumns.filter(col => !EXPECTED_COLUMNS.includes(col));\n\n  if (missing.length > 0 || extra.length > 0) {\n    console.log(\n      `[Doare Sync] Estrutura do CSV difere do esperado. ` +\n      `Colunas faltando: ${missing.length ? missing.join(\", \") : \"nenhuma\"}. ` +\n      `Colunas extras/inesperadas: ${extra.length ? extra.join(\", \") : \"nenhuma\"}.`\n    );\n  }\n}\n\nreturn items;"
