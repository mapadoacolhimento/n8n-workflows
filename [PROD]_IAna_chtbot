      "parameters": {
        "name": "db_schema",
        "description": "Call this tool to get a description of the DB Schema",
        "jsCode": "const dbSchema =\n[\n    {\n        table_name: \"msr.msrs\",\n        table_description: \"Essa tabela contém as informações das MSRs (Mulher em Situação de Risco) atendidas pelo Mapa do Acolhimento. Essa tabela contém informações que não são PII.\",\n        table_columns: [\n            {\n                column_name: \"msr_id\",\n                column_type: \"BIGINT\",\n                column_description: \"ID único da MSR. Também corresponde ao user ID do Zendesk.\"\n            },\n            {\n                column_name: \"gender\",\n                column_type: \"ENUM\",\n                column_description: \"Gênero da MSR. As opções são: cis_woman (mulher cis), trans_woman (mulher trans) e not_found (informação não disponível).\"\n            },\n            {\n                column_name: \"race_color\",\n                column_type: \"ENUM\",\n                column_description: \"Raça e/ou cor da MSR. As opções são black (preta), brown (parda), indigenous (indígena), white (branca), yellow (amarela), prefer_not_to_answer (prefere não responder), not_found (informação não disponível).\"\n            },\n            {\n                column_name: \"has_disability\",\n                column_type: \"BOOL\",\n                column_description: \"Indica se a MSR tem deficiência. Pode ser nulo, caso essa informação não esteja disponível.\"\n            },\n            {\n                column_name: \"accepts_online_support\",\n                column_type: \"BOOL\",\n                column_description: \"Indica se a MSR aceita receber atendimento online.\"\n            },\n            {\n                column_name: \"zipcode\",\n                column_type: \"VARCHAR\",\n                column_description: \"Zipcode (ou CEP, no Brasil) da MSR.\"\n            },\n            {\n                column_name: \"neighborhood\",\n                column_type: \"VARCHAR\",\n                column_description: \"Bairro da MSR.\"\n            },\n            {\n                column_name: \"city\",\n                column_type: \"VARCHAR\",\n                column_description: \"Cidade da MSR. Todos os valores estão em upper case e sem caracteres especiais.\"\n            },\n            {\n                column_name: \"state\",\n                column_type: \"VARCHAR\",\n                column_description: \"Sigla do Estado da MSR.\"\n            },\n            {\n                column_name: \"status\",\n                column_type: \"ENUM\",\n                column_description: \"Status atual da MSR. As opções são `registered` (cadastrada), registered_by_public_service (referenciada pelo serviço público) e `unregistered` (descadastrada).\"\n            },\n            {\n                column_name: \"created_at\",\n                column_type: \"TIMESTAMP\",\n                column_description: \"Timestamp de cadastro da MSR.\"\n            },\n            {\n                column_name: \"updated_at\",\n                column_type: \"TIMESTAMP\",\n                column_description: \"Timestamp da última atualização da linha.\"\n            }\n        ]\n    },\n    {\n        table_name: \"pii_sec.msr_pii\",\n        table_description: \"Essa tabela contém as informações das MSRs (Mulher em Situação de Risco) atendidas pelo Mapa do Acolhimento. Essa tabela contém informações que são PII.\",\n        table_columns: [\n            {\n                column_name: \"msr_id\",\n                column_type: \"BIGINT\",\n                column_description: \"ID único da MSR. Também corresponde ao user ID do Zendesk.\"\n            },\n            {\n                column_name: \"first_name\",\n                column_type: \"VARCHAR\",\n                column_description: \"Primeiro nome da MSR.\"\n            },\n            {\n                column_name: \"email\",\n                column_type: \"VARCHAR\",\n                column_description: \"E-mail da MSR.\"\n            },\n            {\n                column_name: \"phone\",\n                column_type: \"VARCHAR\",\n                column_description: \"Telefone da MSR.\"\n            },\n            {\n                column_name: \"date_of_birth\",\n                column_type: \"DATETIME\",\n                column_description: \"Data de nascimento da MSR. Pode ser nulo se essa informação não estiver disponível.\"\n            },\n            {\n                column_name: \"created_at\",\n                column_type: \"TIMESTAMP\",\n                column_description: \"Timestamp de cadastro da MSR.\"\n            },\n            {\n                column_name: \"updated_at\",\n                column_type: \"TIMESTAMP\",\n                column_description: \"Timestamp da última atualização da linha.\"\n            }\n        ]\n    },\n    {\n        table_name: \"msr.msr_status_history\",\n        table_description: \"Essa tabela contém o histórico de status das MSRs (Mulher em Situação de Risco) atendidas pelo Mapa do Acolhimento.\",\n        table_columns: [\n            {\n                column_name: \"msr_status_history_id\",\n                column_type: \"INT\",\n                column_description: \"ID único da tabela.\"\n            },\n            {\n                column_name: \"msr_id\",\n                column_type: \"BIGINT\",\n                column_description: \"ID único da MSR. Também corresponde ao user ID do Zendesk.\"\n            },\n            {\n                column_name: \"status\",\n                column_type: \"ENUM\",\n                column_description: \"Status da MSR. As opções são `registered` (cadastrada), registered_by_public_service (referenciada pelo serviço público) e `unregistered` (descadastrada).\"\n            },\n            {\n                column_name: \"created_at\",\n                column_type: \"TIMESTAMP\",\n                column_description: \"Timestamp de criação desse status.\"\n            },\n        ]\n    },\n    // NOVO: tabela não existia no dbSchema anterior\n    {\n        table_name: \"msr.msr_violence_history\",\n        table_description: \"Essa tabela contém o histórico de violência sofrida pela MSR (Mulher em Situação de Risco), coletado no momento do cadastro no Mapa do Acolhimento. Essa tabela contém informações que não são PII.\",\n        table_columns: [\n            {\n                column_name: \"msr_violence_history_id\",\n                column_type: \"INT\",\n                column_description: \"ID único da tabela.\"\n            },\n            {\n                column_name: \"msr_id\",\n                column_type: \"BIGINT\",\n                column_description: \"ID único da MSR.\"\n            },\n            {\n                column_name: \"violence_type\",\n                column_type: \"ARRAY(ENUM)\",\n                column_description: \"Tipo(s) de violência sofrida pela MSR. Pode conter mais de um valor. As opções são physical_violence (física), psychological_violence (psicológica), sexual_violence (sexual), moral_violence (moral), digital_violence (digital), patrimonial_violence (patrimonial), obstetric_violence (obstétrica), threat (ameaça), political_violence (política), no_violence (nenhuma violência).\"\n            },\n            {\n                column_name: \"violence_time\",\n                column_type: \"ENUM\",\n                column_description: \"Há quanto tempo a violência ocorre/ocorreu. As opções são last_week (semana passada), less_than_3_months (menos de 3 meses), between_3_months_and_1_year (entre 3 meses e 1 ano), between_1_and_3_years (entre 1 ano e 3 anos), between_3_and_6_years (entre 3 anos e 6 anos), between_6_and_10_years (entre 6 anos e 10 anos), more_than_10_years (mais de 10 anos).\"\n            },\n            {\n                column_name: \"violence_occurred_in_brazil\",\n                column_type: \"BOOL\",\n                column_description: \"Indica se a violência ocorreu no Brasil.\"\n            },\n            {\n                column_name: \"perpetrator_gender\",\n                column_type: \"ENUM\",\n                column_description: \"Gênero do agressor. As opções são woman (mulher), man (homem), non_binary (não binário). Pode ser nulo.\"\n            },\n            {\n                column_name: \"violence_perpetrator\",\n                column_type: \"ARRAY(ENUM)\",\n                column_description: \"Relação do agressor com a MSR. Pode conter mais de um valor. As opções são nuclear_family (família nuclear), close_family (família próxima), current_partner (parceiro atual), ex_partner (ex-parceiro), work_colleague (colega de trabalho), other_people (outras pessoas).\"\n            },\n            {\n                column_name: \"lives_with_perpetrator\",\n                column_type: \"ENUM\",\n                column_description: \"Indica se a MSR mora com o agressor. As opções são yes (sim), no (não), never (nunca). Pode ser nulo.\"\n            },\n            {\n                column_name: \"violence_location\",\n                column_type: \"ARRAY(ENUM)\",\n                column_description: \"Local(is) onde a violência ocorre/ocorreu. Pode conter mais de um valor. As opções são home_space (espaço doméstico), public_space (espaço público), work_space (espaço de trabalho), internet_space (internet).\"\n            },\n            {\n                column_name: \"legal_actions_taken\",\n                column_type: \"ARRAY(ENUM)\",\n                column_description: \"Ações legais já tomadas pela MSR. Pode conter mais de um valor. As opções são physical_examination (exame de corpo de delito), police_inquiry (inquérito policial), criminal_case (processo criminal), civil_case (processo cível), labour_case (processo trabalhista), police_report (boletim de ocorrência), protective_measure (medida protetiva), none_taken (nenhuma).\"\n            },\n            {\n                column_name: \"legal_action_difficulty\",\n                column_type: \"ARRAY(ENUM)\",\n                column_description: \"Dificuldades enfrentadas pela MSR ao tomar ações legais. Pode conter mais de um valor. As opções são discouraged (foi desencorajada), not_competent (órgão não competente), refused_to_register (recusaram registrar), no_access_to_justice (sem acesso à justiça), denied_restraining_order (medida protetiva negada), not_applicable (não se aplica).\"\n            },\n            {\n                column_name: \"protective_factors\",\n                column_type: \"ARRAY(ENUM)\",\n                column_description: \"Fatores de proteção identificados no caso da MSR. Pode conter mais de um valor. As opções são support_network (rede de apoio), dont_live_with_perpetrator (não mora com o agressor), feels_safe (sente-se segura), is_not_dependant (não é dependente do agressor), has_qualified_public_services (tem acesso a serviços públicos qualificados), not_applicable (não se aplica).\"\n            },\n            {\n                column_name: \"risk_factors\",\n                column_type: \"ARRAY(ENUM)\",\n                column_description: \"Fatores de risco identificados no caso da MSR. Pode conter mais de um valor. As opções são gun_access (agressor tem acesso a arma de fogo), private_captivity (cárcere privado), violence_during_pregnancy (violência durante a gravidez), denied_public_services (serviços públicos negados), no_support_network (sem rede de apoio), perpetrator_is_a_criminal (agressor tem antecedentes criminais), perpetrator_is_imprisoned (agressor está preso), feels_isolated (sente-se isolada), other_risks (outros riscos), needed_medical_attention (precisou de atendimento médico), not_applicable (não se aplica).\"\n            },\n            {\n                column_name: \"created_at\",\n                column_type: \"TIMESTAMP\",\n                column_description: \"Timestamp de criação da linha.\"\n            },\n            {\n                column_name: \"updated_at\",\n                column_type: \"TIMESTAMP\",\n                column_description: \"Timestamp da última atualização da linha.\"\n            },\n        ]\n    },\n    // NOVO: tabela não existia no dbSchema anterior\n    {\n        table_name: \"msr.msr_socioeconomic_data\",\n        table_description: \"Essa tabela contém as informações socioeconômicas da MSR (Mulher em Situação de Risco), coletadas no momento do cadastro no Mapa do Acolhimento. Essa tabela contém informações que não são PII.\",\n        table_columns: [\n            {\n                column_name: \"msr_socioeconomic_id\",\n                column_type: \"INT\",\n                column_description: \"ID único da tabela.\"\n            },\n            {\n                column_name: \"msr_id\",\n                column_type: \"BIGINT\",\n                column_description: \"ID único da MSR.\"\n            },\n            {\n                column_name: \"has_monthly_income\",\n                column_type: \"ENUM\",\n                column_description: \"Indica se a MSR possui renda mensal. As opções são yes, no, no_access (sem acesso a essa informação). Pode ser nulo.\"\n            },\n            {\n                column_name: \"monthly_income_range\",\n                column_type: \"ENUM\",\n                column_description: \"Faixa de renda mensal da MSR. As opções são no_income (sem renda), half_minimum_wage (meio salário mínimo), up_to_one_minimum_wage (até 1 salário mínimo), up_to_two_minimum_wages (até 2 salários mínimos), up_to_three_minimum_wages (até 3 salários mínimos), up_to_four_minimum_wages (até 4 salários mínimos), five_minimum_wages_or_more (5 salários mínimos ou mais). Pode ser nulo.\"\n            },\n            {\n                column_name: \"employment_status\",\n                column_type: \"ENUM\",\n                column_description: \"Situação de emprego da MSR. As opções são employed_clt (empregada CLT), employed_pj (empregada PJ), student (estudante), student_with_income (estudante com renda