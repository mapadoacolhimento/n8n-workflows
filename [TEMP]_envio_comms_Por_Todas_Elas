      "parameters": {
        "operation": "executeQuery",
        "query": "WITH matches_status AS (\n    SELECT\n        m.msr_id,\n        pii.email,\n        pii.first_name AS nome_msr,\n        m.support_type,\n        m.match_id,\n        m.status,\n        m.updated_at,\n        ROW_NUMBER() OVER (\n            PARTITION BY m.msr_id\n            ORDER BY m.updated_at DESC\n        ) AS rn\n    FROM match.matches m\n    JOIN pii_sec.msr_pii pii\n        ON pii.msr_id = m.msr_id\n    LEFT JOIN public.volunteers v\n        ON v.id = m.volunteer_id\n    WHERE m.status IN ('in_contact', 'completed')\n)\n\nSELECT\n    msr_id,\n    nome_msr,\n    support_type,\n    email,\n    CASE\n        WHEN status = 'in_contact' THEN 'Em atendimento'\n        WHEN status = 'completed' THEN 'Atendimento concluído'\n    END AS status_atendimento,\n    updated_at AS data_status\nFROM matches_status\nWHERE rn = 1\nORDER BY updated_at DESC;",
